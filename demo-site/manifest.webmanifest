{
  "name": "Better X",
  "short_name": "Better X",
  "description": "A private, local-first Chrome extension for X: save posts to a library in your browser, download their media, and hide the clutter. This site is its live demo.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "theme_color": "#000000",
  "background_color": "#000000",
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
