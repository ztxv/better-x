{
  "name": "better-x",
  "version": "1.1.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "check": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,html}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md,html}\" --ignore-path .gitignore",
    "smoke": "wxt build && node scripts/smoke/run.mjs && node scripts/smoke/restart.mjs && node scripts/smoke/reload.mjs && node scripts/smoke/catalog.mjs && node scripts/smoke/launch.mjs && node scripts/smoke/insights.mjs && node scripts/smoke/theme.mjs && node scripts/smoke/overlay.mjs",
    "perf": "wxt build && node scripts/perf/run.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "simple-icons": "^16.34.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
