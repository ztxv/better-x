{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": ["chrome", "vitest/globals"],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".wxt/**/*.ts"],
  "exclude": ["node_modules", ".output"]
}
